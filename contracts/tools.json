{
  "version": 1,
  "tools": [
    {
      "name": "add_test_case",
      "title": "Add a test case",
      "description": "Add a custom test case to the user's Testcase panel (function-judge problems only).\nThe expected output is computed by the reference solution. Every case belongs to a\ngroup: `section` must be one of the problem's section ids (see get_problem), and may be\nomitted only when the problem has a single group. Cases are shown as `Test <n>`.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "args": {
            "items": {},
            "title": "Args",
            "type": "array"
          },
          "kwargs": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Kwargs"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Name"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Section"
          },
          "problem_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Problem Id"
          }
        },
        "required": [
          "args"
        ],
        "title": "add_test_caseArguments"
      },
      "annotations": {
        "readOnlyHint": false,
        "consequentialHint": false,
        "untrustedContentHint": false
      },
      "browser": true
    },
    {
      "name": "annotate",
      "title": "Annotate code",
      "description": "Comment on the user's code. Each annotation marks an exact character range in a\nvisible file (or is a general comment when file is omitted). In the editor it shows as a\nhighlight plus one gutter dot (a bar for several lines); hovering peeks at it and\nclicking focuses it in the Review tab. Lines and columns are 1-based and refer to the\ncurrent code from get_session; end_col is exclusive. Always prefer start_col/end_col\nthat cover just the offending token or expression; without columns the whole text of\nthe line(s) is marked. Comments may overlap, and each stays visible. For a tutorial cell\npass problem_id=\"tut-<tutorial id>\" and file=\"cells/<cell id>.py\".",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "AnnotationIn": {
            "properties": {
              "file": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Visible file path; omit for a general comment.",
                "title": "File"
              },
              "start_line": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "1-based first line (required with file).",
                "title": "Start Line"
              },
              "end_line": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "1-based last line; defaults to start_line.",
                "title": "End Line"
              },
              "start_col": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "1-based column where the highlight starts on start_line. Give exact columns whenever the problem is one token or expression. Omit both columns to mark the text of the line(s), without indentation.",
                "title": "Start Col"
              },
              "end_col": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "1-based column on end_line, exclusive (one past the last highlighted character). Defaults to the end of the text on end_line when start_col is given.",
                "title": "End Col"
              },
              "severity": {
                "default": "info",
                "enum": [
                  "info",
                  "hint",
                  "warning",
                  "error",
                  "praise"
                ],
                "title": "Severity",
                "type": "string"
              },
              "message": {
                "description": "Markdown. Keep it short and specific.",
                "title": "Message",
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "title": "AnnotationIn",
            "type": "object"
          }
        },
        "properties": {
          "annotations": {
            "items": {
              "$ref": "#/$defs/AnnotationIn"
            },
            "title": "Annotations",
            "type": "array"
          },
          "problem_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Problem Id"
          },
          "author": {
            "default": "assistant",
            "title": "Author",
            "type": "string"
          }
        },
        "required": [
          "annotations"
        ],
        "title": "annotateArguments"
      },
      "annotations": {
        "readOnlyHint": false,
        "consequentialHint": false,
        "untrustedContentHint": false
      },
      "browser": true
    },

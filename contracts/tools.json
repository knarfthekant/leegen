    {
      "name": "propose_edit",
      "title": "Propose an edit",
      "description": "Suggest a change to one of the user's editable files. Shown as a diff the user accepts\nor rejects. Give either the full new `content` or a list of exact search/replace\n`edits`. A newer proposal for the same file replaces the pending one. For a tutorial cell\npass problem_id=\"tut-<tutorial id>\" and file=\"cells/<cell id>.py\".",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "EditIn": {
            "properties": {
              "old": {
                "description": "Exact text currently in the file; must match exactly once.",
                "title": "Old",
                "type": "string"
              },
              "new": {
                "description": "Replacement text.",
                "title": "New",
                "type": "string"
              }
            },
            "required": [
              "old",
              "new"
            ],
            "title": "EditIn",
            "type": "object"
          }
        },
        "properties": {
          "file": {
            "title": "File",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content"
          },
          "edits": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/EditIn"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Edits"
          },
          "problem_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Problem Id"
          },
          "author": {
            "default": "assistant",
            "title": "Author",
            "type": "string"
          }
        },
        "required": [
          "file",
          "rationale"
        ],
        "title": "propose_editArguments"
      },
      "annotations": {
        "readOnlyHint": false,
        "consequentialHint": false,
        "untrustedContentHint": false
      },
      "browser": true
    },

            "title": "Yaml",
            "type": "string"
          }
        },
        "required": [
          "yaml"
        ],
        "title": "validate_problem_yamlArguments"
      },
      "annotations": {
        "readOnlyHint": true,
        "consequentialHint": false,
        "untrustedContentHint": false
      },
      "browser": true
    }
  ]
}

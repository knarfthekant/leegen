    {
      "name": "propose_edit",
      "title": "Propose an edit",
      "description": "Suggest a change to one of the user's editable files. Shown as a diff the user accepts\nor rejects. Give either the full new `content` or a list of exact search/replace\n`edits`. A newer proposal for the same file replaces the pending one.",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "EditIn": {
            "properties": {
              "old": {
                "description": "Exact text currently in the file; must match exactly once.",
                "title": "Old",
                "type": "string"
              },
              "new": {
                "description": "Replacement text.",
                "title": "New",
                "type": "string"
              }
            },
            "required": [
              "old",
              "new"
            ],
            "title": "EditIn",
            "type": "object"
          }
        },
        "properties": {
          "file": {
            "title": "File",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content"
          },
          "edits": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/EditIn"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Edits"
          },
          "problem_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Problem Id"
          },
          "author": {
            "default": "assistant",
            "title": "Author",
            "type": "string"
          }
        },
        "required": [
          "file",
          "rationale"
        ],
        "title": "propose_editArguments"
      },
      "annotations": {
        "readOnlyHint": false,
        "consequentialHint": false,
        "untrustedContentHint": false
      },
      "browser": true
    },
    {
      "name": "run_tests",
      "title": "Run tests",
      "description": "Run the user's current code against all tests (the same as clicking Run). Results\nappear in the UI too. Returns failing tests (or every test with full=true).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "problem_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Problem Id"
          },
          "full": {
            "default": false,
            "title": "Full",
            "type": "boolean"
          }
        },
        "title": "run_testsArguments"
      },
      "annotations": {
        "readOnlyHint": false,
        "consequentialHint": false,
        "untrustedContentHint": true
      },
      "browser": true
    },
    {
      "name": "update_problem",
      "title": "Update problem",
      "description": "Replace an existing problem with new YAML (validated the same way as create_problem).\nThe user's saved code for the problem is kept.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "problem_id": {
            "title": "Problem Id",
            "type": "string"
          },
          "yaml": {
            "title": "Yaml",
            "type": "string"
          }
        },
        "required": [
          "problem_id",
          "yaml"
